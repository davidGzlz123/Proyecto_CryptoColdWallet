flowchart LR
    %% === ENTRADAS ===
    User("Usuario")
    PassInput("Passphrase")
    
    User -->|Escribe| PassInput

    %% === 1. DERIVACIÓN (Azul Opaco) ===
    subgraph GEN_CLAVE ["1. DERIVACIÓN DE LLAVE (Argon2id)"]
        direction TB
        Salt("Salt Aleatorio<br/>(16 Bytes)")
        KDF_Func("Función Argon2id")
        MasterKey("Llave Maestra Derivada<br/>(32 Bytes)")
        
        Salt --> KDF_Func
        KDF_Func -->|Produce| MasterKey
    end

    %% === 2. CIFRADO (Naranja Opaco) ===
    subgraph CIFRADO ["2. CIFRADO SIMÉTRICO (AES-GCM)"]
        direction TB
        PrivKey("Llave Privada Ed25519<br/>(El Secreto)")
        Nonce("Nonce Único<br/>(Aleatorio)")
        Cipher("Cifrador AES-256-GCM")
        
        Ciphertext("Texto Cifrado<br/>(Bytes ilegibles)")
        Tag("Tag de Autenticación<br/>(Asegura Integridad)")
        
        Cipher -->|Genera| Ciphertext
        Cipher -->|Genera| Tag
    end

    %% === 3. ARCHIVO FINAL (Gris Opaco) ===
    subgraph ARCHIVO ["3. ESTRUCTURA JSON (keystore.json)"]
        direction TB
        JSON("Objeto JSON Final<br/>{ version: 1, pubkey: '...', crypto: {...}, checksum: ... }")
    end

    %% === CONEXIONES ===
    linkStyle default stroke:#333,stroke-width:2px,fill:none,curve:basis;

    PassInput --> KDF_Func
    MasterKey --> Cipher
    PrivKey --> Cipher
    Nonce --> Cipher
    
    Ciphertext --> JSON
    Tag --> JSON
    Nonce --> JSON
    Salt --> JSON

    %% === ESTILOS VISUALES ===
    style User fill:#fff,stroke:#333,stroke-width:2px,color:#000
    style PassInput fill:#fff,stroke:#333,stroke-width:1px,color:#000
    style Salt fill:#fff,stroke:#333,stroke-width:1px,color:#000
    style KDF_Func fill:#fff,stroke:#333,stroke-width:1px,color:#000
    style MasterKey fill:#fff,stroke:#333,stroke-width:1px,color:#000
    style PrivKey fill:#fff,stroke:#333,stroke-width:1px,color:#000
    style Nonce fill:#fff,stroke:#333,stroke-width:1px,color:#000
    style Cipher fill:#fff,stroke:#333,stroke-width:1px,color:#000
    style Ciphertext fill:#fff,stroke:#333,stroke-width:1px,color:#000
    style Tag fill:#fff,stroke:#333,stroke-width:1px,color:#000
    style JSON fill:#fff,stroke:#333,stroke-width:2px,stroke-dasharray: 5 5,color:#000

    %% Estilos de Grupos (Padding 60px)
    style GEN_CLAVE fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#0d47a1,font-weight:bold,padding:60px
    style CIFRADO fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#e65100,font-weight:bold,padding:60px
    style ARCHIVO fill:#eceff1,stroke:#455a64,stroke-width:2px,color:#263238,font-weight:bold,padding:60px